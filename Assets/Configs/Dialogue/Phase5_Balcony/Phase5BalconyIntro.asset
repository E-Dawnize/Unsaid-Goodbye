  DialogueId: dialogue_phase5_balcony_intro
  CompletionId: {fileID: 0}
  Lines:
  - "\u539f\u672c\u7a7a\u8361\u8361\u7684\u9e1f\u7b3c\u51fa\u73b0\u4e86\u4e00\u53ea\u7eff\u8272\u9e66\u9e49\uff0c\u7b3c\u95e8\u865a\u63a9\u3002\u5b83\u7ad9\u5728\u6816\u6728\u4e0a\uff0c\u7fc5\u8180\u534a\u5f20\uff0c\u50cf\u521a\u98de\u56de\u6765\uff0c\u53c8\u50cf\u51c6\u5907\u8d77\u98de\u3002\u5b83\u4e00\u4f1a\u770b\u7740\u7b3c\u5916\u7684\u5929\u7a7a\uff0c\u4e00\u4f1a\u53c8\u770b\u770b\u7a7a\u8361\u8361\u7684\u623f\u95f4\u3002"
  - "\u5b83\u4e0d\u5e94\u8be5\u5728\u8fd9\u91cc\u3002\u5979\u8bf4\u8fc7\uff0c\u9e1f\u98de\u8d70\u4e86\u3002"
  - "\u9633\u53f0\u6ca1\u6709\u5c01\u7a97\u3002\u5979\u8bf4\u4ece\u524d\u7684\u65f6\u5019\uff0c\u5b83\u4f1a\u81ea\u5df1\u56de\u6765\u2014\u2014\u6bcf\u6b21\u98de\u51fa\u53bb\u6e9c\u98ce\uff0c\u508d\u665a\u5c31\u4f1a\u987a\u7740\u98ce\u843d\u56de\u680f\u6746\u3002"
